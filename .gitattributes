# Texto normalizado al versionar; PowerShell conserva finales Windows.
* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.csv text eol=lf
*.svg text eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
